# Required: Notion internal integration token
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Choose ONE parent target:
# 1) Parent page where docs page will be created as a child
NOTION_PARENT_PAGE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OR 2) Database where docs page will be created/updated as a row (page)
# NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Page title used for upsert exact-match search.
# Defaults to package name/repo folder name when omitted.
NOTION_PAGE_TITLE=FamilyGuard AI Documentation
